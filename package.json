{
  "name": "@wanlianyida/wop-typescript-sdk",
  "version": "0.1.0",
  "description": "WOP 商户侧官方 TypeScript SDK：协议核心（签名/摘要/L2 数字信封/验签解密）+ 可插拔 HTTP 适配层",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wop-platform/wop-typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/wop-platform/wop-typescript-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./axios": {
      "import": {
        "types": "./dist/axios.d.ts",
        "default": "./dist/axios.js"
      },
      "require": {
        "types": "./dist/axios.d.cts",
        "default": "./dist/axios.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "axios": [
        "dist/axios.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
  "build": "tsup",
  "test": "vitest run",
  "test:watch": "vitest",
  "test:dist": "publint && attw --pack . && node tests/smoke.cjs && node tests/smoke.mjs",
  "coverage": "vitest run --coverage",
  "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "wop",
    "gateway",
    "rsa",
    "digital-envelope",
    "aes-gcm",
    "webcrypto"
  ],
  "peerDependencies": {
    "axios": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.4",
    "axios": "^1.13.2",
    "publint": "^0.3.24",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
