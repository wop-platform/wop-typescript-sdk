# hosting 平台配置（ADR-008）：本仓托管在 GitHub，hosting.py 原生兼容（FACTORY_HOSTING=github 为默认值）。
# 用法：链入口 source 本文件（bash：source .factory/hosting.env && .factory/fix-issue.sh ...；
# cron/LaunchAgent：EnvironmentVariables 或 BASH_ENV 指向本文件路径）
# 令牌不入库：GH_TOKEN / GITHUB_TOKEN 在 shell profile / keychain 提供；仓库 slug 由
# hosting.py 从 git remote（github remote 优先，其次 origin）自动推导，也可用 GH_REPO 显式指定。
export FACTORY_HOSTING=github
export FACTORY_BASE_BRANCH=main               # 链基线（两级回退 env 级）
